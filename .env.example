# Copy this file to .env.local and fill in your keys.

# Used by "The Bible Says" verse lookup.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Used by the Video Transcriber for speech-to-text on TikTok / Instagram /
# Facebook / X and any video without free captions. Get one at
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override binary locations if yt-dlp / ffmpeg aren't on PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg
